{
  "name": "panier-fute-quebec",
  "version": "1.2.2",
  "description": "Compare les circulaires IGA, Super C, Maxi et Walmart et propose des recettes selon les rabais. Site web + app Android (PWA).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json && tsc -p jsconfig.sw.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
